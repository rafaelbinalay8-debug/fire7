local function addToList(text, color, isRemote, remoteObj)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 25)
    btn.BackgroundTransparency = 0.8
    btn.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
    btn.Text = text
    btn.TextColor3 = color or Color3.new(1, 1, 1)
    btn.Font = Enum.Font.Code
    btn.TextSize = 14
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = scroll
    
    btn.MouseButton1Click:Connect(function()
        if isRemote and remoteObj then
            status.Text = "Firing: " .. remoteObj.Name .. "..."
            -- Spam fire dengan berbagai argumen umum buat nge-bypass validasi server
            local args = {
                {1}, -- ID 1
                {"1"}, -- String 1
                {1, 1}, -- ID, Quantity
                {"1", 1},
                {player, 1}, -- Player, ID
                {1, true}, -- ID, Free flag
                {1, 0}, -- ID, Cost 0
                {1, "Free"}, 
                {1, -1}, -- ID, Negative cost
                {tostring(1)},
            }
            
            for _, arg in ipairs(args) do
                pcall(function()
                    remoteObj:FireServer(unpack(arg))
                end)
            end
            status.Text = "Spammed " .. remoteObj.Name .. " with 10 payload variations."
        else
            if setclipboard then
                setclipboard(text)
                status.Text = "Copied to clipboard!"
            end
        end
    end)
end

local function scanRemotes()
    local count = 0
    status.Text = "Gnawing through ReplicatedStorage..."
    task.wait()
    
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
            local name = obj.Name:lower()
            if string.find(name, "buy") or string.find(name, "shop") or 
               string.find(name, "purchase") or string.find(name, "item") or
               string.find(name, "get") or string.find(name, "claim") or
               string.find(name, "spawn") or string.find(name, "give") then
                
                addToList("REMOTE: " .. obj.Name .. " (" .. obj.ClassName .. ")", Color3.fromRGB(100, 255, 100), true, obj)
                count = count + 1
            end
        end
    end
    
    status.Text = "Found " .. count .. " potential shop remotes. Click to spam payload."
end

